{
	"name": "runkiln-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build -w @runkiln/tui && npm run build -w @runkiln/ai && npm run build -w @runkiln/agent-core && npm run build -w @runkiln/coding-agent",
		"build:binaries": "node scripts/build-binaries.mjs",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"postject": "1.0.0-alpha.6",
		"shx": "0.3.4",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.1.0"
}
