{
	"name": "@runkiln/tui",
	"version": "0.1.3",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts"
	},
	"files": [
		"dist/**/*",
		"!dist/**/*.map",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"native/linux/README.md",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Jonathan Ly",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LyJonathan/RunKiln.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"os": [
		"win32",
		"linux",
		"darwin"
	],
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.11"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "6.0.0"
	},
	"homepage": "https://github.com/LyJonathan/RunKiln/tree/main/packages/tui#readme",
	"bugs": {
		"url": "https://github.com/LyJonathan/RunKiln/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
