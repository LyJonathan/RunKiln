{
	"name": "@runkiln/agent-core",
	"version": "0.1.2",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@runkiln/ai": "0.1.2",
		"typebox": "1.3.27"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Jonathan Ly",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LyJonathan/RunKiln.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	},
	"homepage": "https://github.com/LyJonathan/RunKiln/tree/main/packages/agent#readme",
	"bugs": {
		"url": "https://github.com/LyJonathan/RunKiln/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
