{
	"name": "@runkiln/coding-agent",
	"version": "0.1.1",
	"description": "RunKiln: fast coding agent CLI for RunInfra",
	"type": "module",
	"runkilnConfig": {
		"name": "runkiln",
		"configDir": ".runkiln"
	},
	"bin": {
		"runkiln": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run build:unbundled && node ../../scripts/build-coding-agent-bundle.mjs",
		"build:unbundled": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js dist/rpc-entry.js && npm run copy-assets",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/modes/interactive/assets && shx cp src/modes/interactive/assets/*.png dist/modes/interactive/assets/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/",
		"test": "vitest --run"
	},
	"dependencies": {
		"@runkiln/agent-core": "0.1.1",
		"@runkiln/ai": "0.1.1",
		"@runkiln/tui": "0.1.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@vscode/tree-sitter-wasm": "0.3.1",
		"brace-expansion": "5.0.12",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"shx": "0.3.4",
		"vitest": "4.1.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Jonathan Ly",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LyJonathan/RunKiln.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"os": [
		"win32",
		"linux",
		"darwin"
	],
	"homepage": "https://github.com/LyJonathan/RunKiln/tree/main/packages/coding-agent#readme",
	"bugs": {
		"url": "https://github.com/LyJonathan/RunKiln/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
